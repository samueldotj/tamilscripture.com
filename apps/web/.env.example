# Copy to .env for local development. Both values are public by design;
# row-level security is the boundary, not the key. The same values are the
# committed defaults in src/lib/supabase/config.ts, so .env is optional
# until a separate development project exists (M3).
PUBLIC_SUPABASE_URL=https://zytgmnqmrvgspjdokajp.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_9kbp5Fkm29ZBkhPxzSkhsg_6yK_SJV7

# Web OAuth client ID from Google Cloud (public). When set, /signin shows
# Google's own button so the prompt names tamilscripture.com, not the
# Supabase domain; unset falls back to the Supabase redirect.
# PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Google Ads conversions (docs/feature_analytics.md §8). All public. Without
# the id, Google's tag never loads; a goal without a label is not tracked.
# PUBLIC_GOOGLE_ADS_ID=AW-1234567890
# PUBLIC_GOOGLE_ADS_LABEL_SIGNUP=AbC-D_efG-h12_34-567
# PUBLIC_GOOGLE_ADS_LABEL_READER=
# PUBLIC_GOOGLE_ADS_LABEL_LISTENER=
# PUBLIC_GOOGLE_ADS_LABEL_ATLAS=
# PUBLIC_GOOGLE_ADS_LABEL_PSALMS=
