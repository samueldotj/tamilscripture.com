[
  {
    "name": "Client JavaScript, all chunks incl. lazily loaded supabase-js (gzip)",
    "path": ".svelte-kit/output/client/_app/immutable/**/*.js",
    "limit": "200 kB",
    "gzip": true
  },
  {
    "name": "Reader route JavaScript excluding lazy chunks (gzip)",
    "path": [".svelte-kit/output/client/_app/immutable/entry/*.js", ".svelte-kit/output/client/_app/immutable/nodes/*.js"],
    "limit": "120 kB",
    "gzip": true
  },
  {
    "name": "Reference parser wasm",
    "path": "../../packages/bible-wasm/pkg/bible_wasm_bg.wasm",
    "limit": "45 kB",
    "gzip": true
  },
  {
    "name": "Tamil serif regular font",
    "path": "static/fonts/noto-serif-tamil-regular.woff2",
    "limit": "80 kB",
    "gzip": false
  }
]
