{
  "ci": {
    "collect": {
      "startServerCommand": "ORIGIN=http://localhost:3000 node build",
      "startServerReadyPattern": "Listening on",
      "url": ["http://localhost:3000/", "http://localhost:3000/irvtam/jonah/1", "http://localhost:3000/irvtam/ruth/1/16-17"],
      "numberOfRuns": 2,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 600000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
